# =================================================================
# AXM Nexus — Muhit Konfiguratsiyasi Misoli (.env.example)
# Hech qanday maxfiy kalitlar yoki parollarni bu yerga yozmang!
# Ushbu fayldan nusxa olib .env fayli yarating: cp .env.example .env
# =================================================================

# Server & Profile
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
FRONTEND_PORT=5173
HTTP_PORT=80

# Database (PostgreSQL 16)
POSTGRES_DB=axvhub
POSTGRES_USER=izzatbek
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_PORT=5432

# Redis Cache
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# SMTP Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-secure-app-password
MAIL_FROM=noreply@axm-nexus.uz

# Security & CORS
APP_JWT_SECRET=generate_a_random_base64_or_hex_key_at_least_256_bits_long
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider Keys (Optional)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
